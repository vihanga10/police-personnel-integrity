# Reverse proxy for the PUBLIC READ-ONLY DEMO (synthetic data only). Replace DEMO_HOSTNAME everywhere.
# Place in /etc/nginx/conf.d/ppi-demo.conf. The app itself serves HTTPS on 127.0.0.1:8443; this proxy is the only public door.

limit_req_zone  $binary_remote_addr zone=ppi_login:10m rate=6r/m;   # per visitor; the app also limits 5/min per account
limit_req_zone  $binary_remote_addr zone=ppi_pages:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=ppi_conn:10m;

server {
    listen 80;
    server_name DEMO_HOSTNAME;
    server_tokens off;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name DEMO_HOSTNAME;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/DEMO_HOSTNAME/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DEMO_HOSTNAME/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 64k;          # no uploads in the public copy
    client_body_timeout 10s;
    client_header_timeout 10s;
    limit_conn ppi_conn 30;

    # OPTIONAL GATE (recommended): a shared passphrase in front of the app, so strangers cannot even reach the login
    # page or lock a named account out by guessing. Create the file with:  htpasswd -c /etc/nginx/ppi-demo.htpasswd panel
    # auth_basic "Panel access";
    # auth_basic_user_file /etc/nginx/ppi-demo.htpasswd;

    # Everything below is the same for every location.
    proxy_pass_request_headers on;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name $host;
    proxy_ssl_verify off;              # loopback hop to the app's own self-signed certificate
    proxy_read_timeout 60s;
    proxy_set_header Host $host;                       # the app requires the exact public host
    proxy_set_header X-Forwarded-For $remote_addr;     # overwrite, never append: the app trusts only this proxy
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Authorization "";                 # the app refuses Authorization headers; drop the gate's

    location = /api/auth/login {
        limit_req zone=ppi_login burst=4 nodelay;
        proxy_pass https://127.0.0.1:8443;
    }
    location / {
        limit_req zone=ppi_pages burst=60 nodelay;
        proxy_pass https://127.0.0.1:8443;
    }
}

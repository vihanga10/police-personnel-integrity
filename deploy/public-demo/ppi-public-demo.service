# /etc/systemd/system/ppi-public-demo.service  -- public read-only demo (synthetic data only)
[Unit]
Description=Police personnel integrity research workspace (public read-only demo)
After=network-online.target
Wants=network-online.target

[Service]
User=ppi
Group=ppi
WorkingDirectory=/srv/ppi/repo/backend
ExecStart=/srv/ppi/repo/backend/.venv/bin/python scripts/serve_public_demo.py \
    --config /srv/ppi/private/workspace-config.json \
    --certificate /srv/ppi/tls/app.crt --tls-key /srv/ppi/tls/app.key \
    --port 8443 --accept-public-synthetic-demo
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/srv/ppi/state /srv/ppi/intake
ReadOnlyPaths=/srv/ppi/keys /srv/ppi/private /srv/ppi/grants /srv/ppi/tls /srv/ppi/repo

[Install]
WantedBy=multi-user.target

FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl python3 python3-cryptography && rm -rf /var/lib/apt/lists/*
WORKDIR /work/fabric/integration
COPY integration/package.json integration/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
WORKDIR /work/public/findings
COPY public/findings/package.json public/findings/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY public/findings/ /work/public/findings/
COPY client/ /work/fabric/client/
COPY findings-chaincode/ /work/fabric/findings-chaincode/
COPY integration/ /work/fabric/integration/
COPY backend/ /work/backend/
# The backend resolves its worker relative to a repository root, not the
# flattened peer-test SDK tree. Keep both ordinary directory layouts.
RUN mkdir -p /work/fabric/blockchain/fabric/integration && \
    cp -a /work/fabric/client /work/fabric/blockchain/fabric/client && \
    cp -a /work/fabric/findings-chaincode /work/fabric/blockchain/fabric/findings-chaincode && \
    cp -a /work/fabric/integration/node_modules /work/fabric/blockchain/fabric/integration/node_modules
RUN python3 -m py_compile /work/backend/app/identity/findings_backend_gate.py /work/backend/app/identity/findings_backend_service.py /work/fabric/integration/backend-service-fixture.py
RUN mkdir -p /work/pipeline/blockchain/public /work/pipeline/blockchain/fabric && \
    cp -a /work/fabric/blockchain/fabric/. /work/pipeline/blockchain/fabric/ && \
    cp -a /work/public/findings /work/pipeline/blockchain/public/findings && \
    cp -a /work/backend /work/pipeline/backend
RUN python3 -m py_compile /work/pipeline/backend/app/identity/findings_backend_pipeline.py /work/fabric/integration/backend-pipeline-fixture.py
WORKDIR /work/fabric/integration
ENV NODE_PATH=/work/fabric/integration/node_modules:/work/public/findings/node_modules
